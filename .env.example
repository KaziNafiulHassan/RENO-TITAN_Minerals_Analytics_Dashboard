# RENO-TITAN Intelligence Platform - Environment Configuration
# Copy this to .env and fill in your Supabase credentials

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_api_key_here

# Optional: Database Connection String (alternative to Supabase)
# DB_CONNECTION_STRING=postgresql://user:password@host:port/database

# Development Flag
DEBUG=false

# Logging Level
LOG_LEVEL=INFO
